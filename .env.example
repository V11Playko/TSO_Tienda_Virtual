# Copiar como .env y ajustar si hace falta. El archivo .env no se sube a git.

# Usado por docker-compose.yml
POSTGRES_DB=catalogo
POSTGRES_USER=catalogo
POSTGRES_PASSWORD=catalogo

# Usado por la aplicación (application.yml). Si no se definen, se usan estos mismos valores.
DB_URL=jdbc:postgresql://localhost:5432/catalogo
DB_USER=catalogo
DB_PASSWORD=catalogo
